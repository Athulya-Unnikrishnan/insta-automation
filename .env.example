# ── Instagram Giveaway Picker — Environment Variables ──────────────────────
#
# Copy this file to .env for local development.
# On Render, set these in the Environment tab of your service dashboard.
#
# --------------------------------------------------------------------------

# Optional: Protect the tool with a password.
# If set, anyone visiting the URL must enter this password first.
# Leave blank (or delete the line) to allow open access.
APP_PASSWORD=

# Directory where per-user Instagram sessions are stored.
# On Render this should match the disk mount path in render.yaml.
# Locally you can leave this as-is or change to any writable path.
SESSION_DIR=/data/sessions

# Directory for debug screenshots (e.g. CAPTCHA pages).
DEBUG_DIR=/data/debug

# Flask/Gunicorn port. Render expects 10000; locally you can use 5000.
PORT=10000
